#!/usr/bin/env bash
# Larry v2 opt-in REAL LIVE adapter; ETH SKHY HYPE; no CL.
set -Eeuo pipefail
umask 077
SELF="$(realpath -- "${BASH_SOURCE[0]}")"
EXTRACT_ONLY=0
if [[ "${1:-}" == '--extract-only' ]]; then
  [[ $# -eq 2 ]] || { echo 'usage: --extract-only NEW_DIRECTORY' >&2; exit 2; }
  DEST="$2"
  [[ ! -e "$DEST" ]] || { echo 'Extract destination must not exist' >&2; exit 2; }
  mkdir -m 700 -p "$DEST"
  EXTRACT_ONLY=1
else
  [[ $# -le 1 ]] || { echo 'usage: bash INSTALL.run [PROJECT_ROOT]' >&2; exit 2; }
  DEST="$(mktemp -d -t larry-real-live.XXXXXXXX)"
  trap 'rm -rf -- "$DEST"' EXIT
fi
python3 - "$SELF" "$DEST" <<'PYEXTRACT'
from pathlib import Path,PurePosixPath
import sys,hashlib,base64,gzip,tarfile,io,json
source=Path(sys.argv[1]).read_bytes();dest=Path(sys.argv[2]).resolve()
marker=b'\n__PAYLOAD_BASE64__\n'
if source.count(marker)!=1:raise SystemExit('Package marker invalid')
b=base64.b64decode(source.split(marker,1)[1],validate=False)
if hashlib.sha256(b).hexdigest()!='843fcf7761f8a5c505e6ced74097ad671dada470ce4b31085ce213d9c6d1e98d':raise SystemExit('Package SHA-256 mismatch')
with tarfile.open(fileobj=io.BytesIO(gzip.decompress(b)),mode='r:') as archive:
    seen=set()
    for member in archive.getmembers():
        name=PurePosixPath(member.name)
        if name.is_absolute() or '..' in name.parts or not member.isfile() or member.name in seen:
            raise SystemExit('Unsafe archive member')
        seen.add(member.name)
        target=dest/member.name;target.parent.mkdir(parents=True,exist_ok=True)
        target.write_bytes(archive.extractfile(member).read());target.chmod(0o700 if target.name=='install.sh' else 0o600)
manifest=json.loads((dest/'MANIFEST.json').read_text())
if seen!={'MANIFEST.json',*manifest}:raise SystemExit('Manifest file set mismatch')
for name,digest in manifest.items():
    if hashlib.sha256((dest/name).read_bytes()).hexdigest()!=digest:raise SystemExit('File integrity failed: '+name)
print('✅ LIVE 패키지 SHA-256 및 파일별 무결성 확인')
PYEXTRACT
if ((EXTRACT_ONLY)); then
  echo "압축 해제만 완료: $DEST (설치·API 요청 없음)"
  exit 0
fi
bash "$DEST/install.sh" "${1:-$HOME/index-sniper-pro}"
exit $?
