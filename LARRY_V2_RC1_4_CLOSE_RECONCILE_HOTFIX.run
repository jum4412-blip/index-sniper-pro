#!/usr/bin/env bash
# Larry v2 rc1.4 native SL/TP close-reconciliation hotfix. Does NOT re-arm live entries.
set -Eeuo pipefail
umask 077
SELF="$(realpath -- "${BASH_SOURCE[0]}")"
EXTRACT_ONLY=0
if [[ "${1:-}" == '--extract-only' ]]; then
  [[ $# -eq 2 ]] || { echo 'usage: --extract-only NEW_DIRECTORY' >&2; exit 2; }
  DEST="$2"; [[ ! -e "$DEST" ]] || { echo 'Extract destination must not exist' >&2; exit 2; }
  mkdir -m 700 -p "$DEST"; EXTRACT_ONLY=1
else
  [[ $# -le 1 ]] || { echo 'usage: bash HOTFIX.run [PROJECT_ROOT]' >&2; exit 2; }
  DEST="$(mktemp -d -t larry-rc14-reconcile.XXXXXXXX)"; trap 'rm -rf -- "$DEST"' EXIT
fi
python3 - "$SELF" "$DEST" <<'PYEXTRACT'
from pathlib import Path,PurePosixPath
import sys,hashlib,base64,gzip,tarfile,io,json
source=Path(sys.argv[1]).read_bytes();dest=Path(sys.argv[2]).resolve();marker=b'\n__PAYLOAD_BASE64__\n'
if source.count(marker)!=1:raise SystemExit('Package marker invalid')
b=base64.b64decode(source.split(marker,1)[1],validate=False)
if hashlib.sha256(b).hexdigest()!='49e64a3c11c66e417222f2462c73c0225c0bd8fa96c8f822c36ad2b9e3e3dccb':raise SystemExit('Package SHA-256 mismatch')
with tarfile.open(fileobj=io.BytesIO(gzip.decompress(b)),mode='r:') as a:
    seen=set()
    for m in a.getmembers():
        n=PurePosixPath(m.name)
        if n.is_absolute() or '..' in n.parts or not m.isfile() or m.name in seen:raise SystemExit('Unsafe archive member')
        seen.add(m.name);t=dest/m.name;t.parent.mkdir(parents=True,exist_ok=True);t.write_bytes(a.extractfile(m).read());t.chmod(0o700 if t.name=='install.sh' else 0o600)
manifest=json.loads((dest/'MANIFEST.json').read_text())
if seen!={'MANIFEST.json',*manifest}:raise SystemExit('Manifest file set mismatch')
for name,digest in manifest.items():
    if hashlib.sha256((dest/name).read_bytes()).hexdigest()!=digest:raise SystemExit('File integrity failed: '+name)
print('✅ Larry v2 rc1.4 복구 패키지 무결성 확인')
PYEXTRACT
if ((EXTRACT_ONLY)); then echo "압축 해제만 완료: $DEST"; exit 0; fi
bash "$DEST/install.sh" "${1:-$HOME/index-sniper-pro}"
exit $?
__PAYLOAD_BASE64__

