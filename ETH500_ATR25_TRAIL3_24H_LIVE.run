#!/usr/bin/env python3
"""Separate ETH Trail3 installer. Install does not call APIs, change accounts, or stop/start bots."""
import argparse,base64,hashlib,io,json,os,shutil,sys,tarfile,tempfile
from pathlib import Path,PurePosixPath
PAYLOAD_SHA = '6da4869c3eea99d4d64add623b8fcb6da1b5d76ff35f6eaea15c87a1f1a73ebf'
PAYLOAD = ''

def main():
    if sys.version_info < (3,11):raise RuntimeError('Python 3.11+ required')
    p=argparse.ArgumentParser();p.add_argument('--verify',action='store_true');p.add_argument('--target',default=str(Path.home()/'eth_larry_trail3_500'));p.add_argument('--extract-only')
    a=p.parse_args();raw=base64.b64decode(PAYLOAD,validate=True)
    if hashlib.sha256(raw).hexdigest()!=PAYLOAD_SHA:raise RuntimeError('PAYLOAD_SHA_MISMATCH')
    with tarfile.open(fileobj=io.BytesIO(raw),mode='r:gz') as t:
        data={}
        for m in t.getmembers():
            n=PurePosixPath(m.name)
            if not m.isfile() or n.is_absolute() or '..' in n.parts or m.name in data:raise RuntimeError('UNSAFE_MEMBER')
            data[m.name]=t.extractfile(m).read()
    manifest=json.loads(data['SOURCE_MANIFEST.json'])
    if set(data)-{'SOURCE_MANIFEST.json'}!=set(manifest['files']):raise RuntimeError('MANIFEST_SET_MISMATCH')
    for n,h in manifest['files'].items():
        if hashlib.sha256(data[n]).hexdigest()!=h:raise RuntimeError('FILE_HASH_MISMATCH '+n)
    print('Verified embedded package and',len(manifest['files']),'file hashes.')
    print('ETHUSDT only / target margin500 USDT / cross5 / target notional2500 USDT')
    print('Initial SL 2.5ATR / completed-3H price-point trail after1R / max24H from fill; no fixed TP.')
    print('Retrospective 31-trade candidate. Largest-winner concentration; cost2+delay recent net0.61. NOT profitability approved.')
    if a.verify:return 0
    dest=Path(a.extract_only or a.target).expanduser().resolve()
    if dest.exists():raise RuntimeError('DESTINATION_EXISTS: no overwrite, no DB reset: '+str(dest))
    dest.parent.mkdir(parents=True,exist_ok=True)
    stage=Path(tempfile.mkdtemp(prefix='.eth500-stage-',dir=dest.parent))
    os.chmod(stage,0o700)
    try:
        for n,b in data.items():
            target=stage/n;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(b);target.chmod(0o700 if n=='eth' else 0o600)
        os.rename(stage,dest)
    finally:
        if stage.exists():shutil.rmtree(stage)
    print('Installed to:',dest)
    print('No old bot stopped, no account settings changed, no API called, no service started.')
    print('Next: cd',dest,'&& ./eth verify && ./eth self-test && ./eth doctor-public')
    print('See README_KO.md. Existing positions/risk histories must be reconciled before explicit LIVE approval.')
    return 0
if __name__=='__main__':
    try:raise SystemExit(main())
    except Exception as exc:print('INSTALL_STOP:',str(exc),file=sys.stderr);raise SystemExit(2)
