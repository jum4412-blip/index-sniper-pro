#!/usr/bin/env python3
"""Install a new BTC ETH live-order candidate. Installation does not start trading."""
import argparse, base64, hashlib, io, json, os, shutil, sys, tarfile, tempfile
from pathlib import Path

def main():
    if sys.version_info < (3,10):
        raise SystemExit('Python 3.10 or newer required')
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--target',type=Path,default=Path.home()/'btc_eth_structure_500_v1')
    p.add_argument('--verify',action='store_true')
    args=p.parse_args()
    raw=base64.b64decode(PAYLOAD,validate=True)
    if hashlib.sha256(raw).hexdigest()!=SHA256:
        raise SystemExit('Payload SHA256 mismatch')
    with tarfile.open(fileobj=io.BytesIO(raw),mode='r:gz') as tar:
        members=tar.getmembers(); names=set(); files={}
        for m in members:
            name=Path(m.name)
            if not m.isfile() or name.is_absolute() or '..' in name.parts or m.name in names:
                raise SystemExit('Unsafe archive member')
            if not name.parts or name.parts[0]!='btc_eth_structure_500_v1':
                raise SystemExit('Unexpected archive root')
            names.add(m.name)
            data=tar.extractfile(m).read()
            files[str(Path(*name.parts[1:]))]=(m,data)
        manifest=json.loads(files['SOURCE_MANIFEST.json'][1])
        if set(manifest)!=set(files)-{'SOURCE_MANIFEST.json'}:
            raise SystemExit('Source manifest members mismatch')
        for name,digest in manifest.items():
            if hashlib.sha256(files[name][1]).hexdigest()!=digest:
                raise SystemExit('Source checksum mismatch: '+name)
        if args.verify:
            print('Verified payload SHA256: '+SHA256)
            print(str(len(files))+' source files. No account or process accessed.')
            return
        target=args.target.expanduser().absolute()
        if target.exists() or target.is_symlink():
            raise SystemExit('Target already exists; existing bots are never overwritten: '+str(target))
        target.parent.mkdir(parents=True,exist_ok=True)
        os.umask(0o077)
        stage=Path(tempfile.mkdtemp(prefix='.structure500-',dir=target.parent))
        package=stage/'package'; package.mkdir()
        try:
            for name,(member,data) in files.items():
                dest=package/name; dest.parent.mkdir(parents=True,exist_ok=True)
                with dest.open('wb') as f:
                    f.write(data); f.flush(); os.fsync(f.fileno())
                dest.chmod(0o700 if member.mode & 0o111 else 0o600)
            if target.exists() or target.is_symlink():
                raise SystemExit('Target appeared during installation; refusing overwrite')
            package.rename(target)
        finally:
            shutil.rmtree(stage)
    print('Installed: '+str(target))
    print('Read README_KO.txt. No trading process started.')
    print('cd '+str(target)+' && ./structure self-test')


SHA256='e9b89173aa3f40f2b8f3ce41443c9b5ca42c7f124ea8b7f04b94f235d6b09b69'
PAYLOAD=''

if __name__=='__main__':
    main()
