#!/usr/bin/env bash
# Larry v2 RC1: ETH / SKHY / HYPE. Default deployment is public-data-only SHADOW.
set -Eeuo pipefail
umask 077
SELF="$(realpath -- "${BASH_SOURCE[0]}")"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
python3 - "$SELF" "$TMP" "45ee1ebefafb2c920fbd98354adef4c6e29e1ecd03c3a20e4e6bd46641f2d494" <<'PY_UNPACK'
from pathlib import Path,PurePosixPath
import sys,base64,gzip,hashlib,tarfile,io,json
source,destination,expected=sys.argv[1:]
marker=b'\n__LARRY_V2_PAYLOAD__\n'
raw=Path(source).read_bytes()
if marker not in raw:raise SystemExit('Missing payload marker')
encoded=b''.join(raw.split(marker,1)[1].split())
blob=base64.b64decode(encoded,validate=True)
if hashlib.sha256(blob).hexdigest()!=expected:raise SystemExit('Payload checksum mismatch; nothing installed')
root=Path(destination);seen=set()
with tarfile.open(fileobj=io.BytesIO(gzip.decompress(blob)),mode='r:') as archive:
    for item in archive:
        path=PurePosixPath(item.name)
        if not item.isfile() or path.is_absolute() or '..' in path.parts or item.name in seen:raise SystemExit('Unsafe/duplicate archive member')
        seen.add(item.name);out=root.joinpath(*path.parts)
        out.parent.mkdir(parents=True,exist_ok=True)
        stream=archive.extractfile(item)
        if stream is None:raise SystemExit('Missing archive data')
        out.write_bytes(stream.read());out.chmod(0o700 if out.name=='install.sh' else 0o600)
manifest=json.loads((root/'MANIFEST.json').read_text())
if set(manifest)|{'MANIFEST.json'}!=seen:raise SystemExit('Unexpected archive contents')
for name,digest in manifest.items():
    if hashlib.sha256((root/name).read_bytes()).hexdigest()!=digest:raise SystemExit('File checksum mismatch: '+name)
print('✅ 내장 패키지 SHA-256 및 파일별 무결성 확인')
PY_UNPACK
if [[ "${1:-}" == '--extract-only' ]]; then
  [[ $# -eq 2 ]] || { echo 'usage: bash installer.run --extract-only NEW_DIRECTORY' >&2; exit 2; }
  [[ ! -e "$2" ]] || { echo 'destination must not already exist' >&2; exit 2; }
  mkdir -p "$2"
  cp -a "$TMP/." "$2/"
  printf 'Extracted only. No API, service or account changes: %s\n' "$2"
  exit 0
fi
if [[ $# -gt 1 ]]; then echo 'usage: bash installer.run [PROJECT_ROOT]' >&2;exit 2;fi
bash "$TMP/install.sh" "${1:-$HOME/index-sniper-pro}"
exit 0
