# Managed by LAB1030 public observer v1
[Unit]
Description=LAB1030 public market observer - NO ACCOUNT ACCESS OR ORDERS
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=@@USER@@
WorkingDirectory=@@ROOT@@/current
ExecStart=@@ROOT@@/venv/bin/python -B -u @@ROOT@@/current/observer.py run --root @@ROOT@@
Restart=on-failure
RestartSec=30
WatchdogSec=180
TimeoutStartSec=180
TimeoutStopSec=45
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@ROOT@@/shared
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
