#!/usr/bin/env python3
"""BTC/ETH EC2 installer/updater. Never starts trading or reads credentials."""
import argparse,base64,hashlib,io,json,os,shutil,subprocess,sys,tarfile,tempfile
from pathlib import Path
def main():
    if sys.version_info<(3,10):raise SystemExit('Python 3.10 or newer is required.')
    parser=argparse.ArgumentParser(description='Install or explicitly update a stopped, flat bot. No process is started.')
    parser.add_argument('--target',type=Path,default=Path.home()/'btc_eth_psych_trend_v1')
    parser.add_argument('--verify',action='store_true')
    parser.add_argument('--list',action='store_true')
    parser.add_argument('--update',action='store_true',help='Preserve existing state/config and make a backup; requires stopped, flat managers.')
    args=parser.parse_args()
    raw=base64.b64decode(PAYLOAD)
    if hashlib.sha256(raw).hexdigest()!=SHA256:raise SystemExit('Payload checksum mismatch.')
    with tarfile.open(fileobj=io.BytesIO(raw),mode='r:gz') as tar:
        members=tar.getmembers()
        for m in members:
            p=Path(m.name)
            if p.is_absolute() or '..' in p.parts or not p.parts or p.parts[0]!='btc_eth_psych_trend_v1' or not m.isfile():
                raise SystemExit('Invalid archive member.')
        if args.list:
            print('\n'.join(m.name for m in members));return
        if args.verify:
            print('Verified payload SHA256: '+SHA256);print(str(len(members))+' source files; no process is started.');return
        target=args.target.expanduser().absolute()
        if target.is_symlink():raise SystemExit('Target must not be a symlink.')
        if target.exists() and not args.update:raise SystemExit('Target already exists. Use --update only after stopping flat managers: '+str(target))
        target.parent.mkdir(parents=True,exist_ok=True)
        stage=Path(tempfile.mkdtemp(prefix='.psych-install-',dir=target.parent))
        try:
            for m in members:
                dest=stage/m.name;dest.parent.mkdir(parents=True,exist_ok=True)
                with tar.extractfile(m) as src,dest.open('wb') as out:shutil.copyfileobj(src,out)
                dest.chmod(0o700 if m.mode&0o111 else 0o600)
            package=stage/'btc_eth_psych_trend_v1'
            manifest=json.loads((package/'SOURCE_MANIFEST.json').read_text())
            for name,expected in manifest.items():
                file=package/name
                if not file.resolve().is_relative_to(package.resolve()) or hashlib.sha256(file.read_bytes()).hexdigest()!=expected:
                    raise SystemExit('Source checksum mismatch: '+name)
            command=[sys.executable,str(package/'scripts/install_release.py'),'--source',str(package),'--target',str(target)]
            if args.update:command.append('--update')
            result=subprocess.run(command,check=False)
            if result.returncode:raise SystemExit(result.returncode)
        finally:shutil.rmtree(stage)
    print('Ready: '+str(target))
    print('No bot started. Read GITHUB_EC2_KO.md for systemd installation and explicit start-live.')

SHA256='d376bc5a615c94ba44e81d71a6c6fb57e34141b2bbfce5a07fd7fb3ce2e19fbb'
PAYLOAD=''
if __name__=='__main__':main()
