#!/usr/bin/env bash
set -euo pipefail
python3 - "$0" "${1:-$HOME/btc_eth_trend_v1}" <<'PY'
import base64,hashlib,io,pathlib,subprocess,sys,tarfile,tempfile
blob=pathlib.Path(sys.argv[1]).read_bytes().split(b'\n__BTC_ETH_RC2_PAYLOAD__\n',1)[1]
payload=base64.b64decode(b''.join(blob.split()),validate=True)
if hashlib.sha256(payload).hexdigest()!='307a48f517203eda0ad0255a6010ec92fdf2abf20a99d3aae3f2b749ebd38940':raise SystemExit('Payload checksum mismatch')
with tempfile.TemporaryDirectory(prefix='btc_eth_rc2_') as tmp:
    root=pathlib.Path(tmp)
    with tarfile.open(fileobj=io.BytesIO(payload),mode='r:gz') as archive:
        for member in archive.getmembers():
            p=pathlib.PurePosixPath(member.name)
            if not member.isfile() or p.is_absolute() or '..' in p.parts:raise SystemExit('Unsafe archive member')
            dest=root/member.name
            dest.parent.mkdir(parents=True,exist_ok=True)
            dest.write_bytes(archive.extractfile(member).read())
    result=subprocess.run([sys.executable,str(root/'apply_update.py'),sys.argv[2]])
    raise SystemExit(result.returncode)
PY
exit $?
